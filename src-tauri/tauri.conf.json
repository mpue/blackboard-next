{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackBoard",
  "version": "3.0.2",
  "identifier": "de.pueski.blackboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BlackBoard Circuit Designer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Perfboard, stripboard, schematic and PCB designer",
    "longDescription": "BlackBoard Circuit Designer – perfboards, stripboards, schematics and PCBs with NGSpice simulation and microcontrollers. Free and open source (AGPL-3.0).",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/256x256.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["bb"],
        "name": "BlackBoard board",
        "description": "BlackBoard board or schematic",
        "mimeType": "application/x-blackboard",
        "role": "Editor"
      }
    ],
    "copyright": "© 2026 Matthias Püski and contributors, AGPL-3.0",
    "license": "AGPL-3.0-only",
    "homepage": "https://pueski.de/blackboard/",
    "macOS": {
      "signingIdentity": "-"
    },
    "publisher": "Matthias Püski",
    "linux": {
      "deb": {
        "section": "electronics",
        "files": {
          "/usr/share/metainfo/de.pueski.blackboard.metainfo.xml": "linux/de.pueski.blackboard.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/de.pueski.blackboard.metainfo.xml": "linux/de.pueski.blackboard.metainfo.xml"
        }
      }
    }
  }
}
