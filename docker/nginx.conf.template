# the visitor's address for the API, as a single address: the reverse proxy in
# front (Caddy) puts it into X-Forwarded-For; without a proxy it is the address
# the request came from. Better Auth limits sign-in attempts per address and
# ignores a list of several.
map $http_x_forwarded_for $client_ip {
    ""      $remote_addr;
    default $http_x_forwarded_for;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml text/plain;

    # note: add_header in a location replaces the server level headers, so
    # every location repeats the security headers

    # accounts and cloud projects: the API container (${API_URL} is filled in
    # when the container starts). The name is looked up per request through
    # Docker's DNS, so the app still starts when there is no API; the editor
    # then simply offers no cloud.
    location /api/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        resolver_timeout 2s;
        set $api ${API_URL};
        proxy_pass $api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # projects of up to MAX_PROJECT_MB (8 MB) are uploaded in one piece
        client_max_body_size 10m;
    }

    # hashed build output never changes
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # the stock mime.types has no entry for web app manifests
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # entry points and the service worker are always revalidated, so updates arrive
    location ~* ^/(index\.html|sw\.js|workbox-[^/]*\.js)?$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri /index.html;
    }

    # library, samples and icons: short cache, revalidated via ETag
    location / {
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ =404;
    }
}
