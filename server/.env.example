# Settings of the BlackBoard server (server/config.ts). For Docker this file
# is server.env next to compose.yaml; scripts/deploy.sh creates it on the
# server from this example. Keep it private (chmod 600): it holds secrets.

# origin the browser sees and the path the app is served under
# (deploy.sh sets both in compose.yaml)
# ORIGIN=https://pueski.de
# PUBLIC_PATH=/blackboard

# signs the sessions; at least 32 characters. Left empty, the server makes
# one and keeps it in DATA_DIR/auth-secret.
# AUTH_SECRET=

# mails for sign-up, password reset and sharing. Without SMTP_HOST the mails
# only go to the log.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="BlackBoard <noreply@example.org>"

# "Sign in with Google": an OAuth client of type "Web application" in the
# Google Cloud console, with
#   authorised JavaScript origin  https://pueski.de
#   authorised redirect URI       https://pueski.de/blackboard/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# limits per user
# MAX_PROJECT_MB=8
# MAX_PROJECTS=200

# the C/C++ compiler of the code editor (compiler/, its own container; set in
# compose.yaml) and how often one account may compile in ten minutes, on top
# of the daily limit of its plan (admin page, "Tarife")
# COMPILER_URL=http://compiler:8789
# MAX_COMPILES=60

# Claude as design assistant: accounts with Professional or Commercial use
# their own Anthropic API key (stored encrypted with AUTH_SECRET). Requests per
# account in ten minutes, against runaway loops.
# MAX_ASSISTANT_REQUESTS=300

# accounts with these addresses are admins (admin page: ?admin), as soon as
# the address is confirmed; several separated by commas
# ADMIN_EMAILS=admin@example.org

# newsletter mails per minute (what the mail provider allows)
# NEWSLETTER_PER_MINUTE=20
